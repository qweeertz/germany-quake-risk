# environment and caches
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# data is downloaded and built locally (quakerisk download / quakerisk build)
data/raw/
data/processed/

# generated web page (built from web/template.html, style.css and app.js)
web/index.html

